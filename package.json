{
  "name": "daily-note-key-plugin",
  "version": "0.1.0",
  "description": "An Obsidian plugin for opening one fixed note.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "esbuild": "0.25.5",
    "obsidian": "1.13.1",
    "typescript": "5.8.3"
  }
}
